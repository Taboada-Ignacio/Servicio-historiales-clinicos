# PostgreSQL utilizado por Docker Compose
POSTGRES_DB=clinical_history
POSTGRES_USER=
POSTGRES_PASSWORD=

# Conexion directa del microservicio (fuera de Docker Compose)
DB_URL=jdbc:postgresql://localhost:5432/clinical_history
DB_USER=
DB_PASSWORD=

# Aplicacion
SERVER_PORT=8080
AUDIT_ENCRYPTION_KEY=
AUDIT_RETENTION_YEARS=10
TRUST_PROXY_HEADERS=false
SECURITY_MODE=local
JWT_ISSUER_URI=
JWT_AUDIENCE=clinical-history-service
PROFESSIONAL_ID_CLAIM=professional_id
PROFESSIONAL_NAME_CLAIM=professional_name
PROFESSIONAL_LICENSE_CLAIM=professional_license
LOCAL_PROFESSIONAL_ID=1
LOCAL_PROFESSIONAL_NAME=Profesional local
LOCAL_PROFESSIONAL_LICENSE=LOCAL

# Almacenamiento de documentos clinicos
CLINICAL_FILES_BUCKET=clinical-files
CLINICAL_FILES_REGION=us-east-1
CLINICAL_FILES_ENDPOINT=http://minio:9000
CLINICAL_FILES_ACCESS_KEY=
CLINICAL_FILES_SECRET_KEY=
CLINICAL_FILES_PATH_STYLE=true
CLINICAL_FILES_RECOMMENDED_BYTES=524288000
# No configurar por debajo del minimo legal adoptado por el sistema (10 anios).
CLINICAL_FILES_RETENTION_YEARS=10

# Antivirus
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MILLIS=10000
